{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlopGPT",
  "version": "../package.json",
  "identifier": "com.cocowmn.flopgpt",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run build:web && npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      { "title": "FlopGPT", "hiddenTitle": true, "dragDropEnabled": false, "width": 1200, "height": 800, "minWidth": 360, "minHeight": 500 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
